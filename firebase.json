{
  "hosting": {
    "site": "bricdersi-net",
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "**/*.md"
    ],
    "headers": [
      {
        "source": "/pdf/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      }
    ],
    "redirects": [
      {
        "source": "/rehber",
        "destination": "/bric-baslangic-rehberi",
        "type": 301
      },
      {
        "source": "/sozluk",
        "destination": "/bric-sozlugu",
        "type": 301
      },
      {
        "source": "/notlar",
        "destination": "/bric-ders-notlari-pdf",
        "type": 301
      },
      {
        "source": "/malzemeler",
        "destination": "/bric-baslangic-rehberi",
        "type": 301
      },
      {
        "source": "/anasayfa",
        "destination": "/",
        "type": 301
      }
    ],
    "cleanUrls": true,
    "trailingSlash": false
  }
}